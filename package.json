{
	"name": "chimera",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "An Electron terminal emulator that can intercept HTTY side-channel chunks.",
	"main": "Chimera/main.js",
	"scripts": {
		"start": "electron .",
		"postinstall": "node scripts/fix-node-pty-permissions.cjs",
		"test": "node --test",
		"test:e2e": "node --test test/Chimera.js"
	},
	"dependencies": {
		"@socketry/htty": "^0.2.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"electron": "^41.4.0",
		"node-pty": "^1.1.0"
	},
	"devDependencies": {
		"playwright": "^1.59.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"node-pty"
		]
	}
